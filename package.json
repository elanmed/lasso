{
  "name": "lasso",
  "packageManager": "pnpm@11.1.0",
  "version": "0.16.0",
  "description": "",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.ts",
    "test": "CI=true node --test src/**/*.test.ts scripts/**/*.test.ts",
    "lint": "eslint src scripts",
    "types": "tsc",
    "prettier-format": "./scripts/prettier.sh write",
    "prettier-check": "./scripts/prettier.sh check",
    "cloc-source": "node scripts/cloc.ts source",
    "cloc-tests": "node scripts/cloc.ts tests",
    "cloc": "pnpm run cloc-source && pnpm run cloc-tests",
    "ci": "CI=true pnpm run test && pnpm run lint && pnpm run types && pnpm run prettier-format",
    "pre-push": "pnpm run test && pnpm run lint && pnpm run types && pnpm run prettier-check",
    "compile": "./scripts/compile.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "cloc": "2.10.0-cloc",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/google": "^4.0.106",
    "@ai-sdk/mcp": "^2.0.85",
    "@ai-sdk/openai": "^4.0.103",
    "@ai-sdk/openai-compatible": "^3.0.79",
    "ai": "^7.0.154",
    "prettier": "^3.9.10",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
